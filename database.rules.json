{
  "rules": {
    "quizzes": {
      // Only system administrator can list all quizzes in admin dashboard
      ".read": "auth != null && auth.token.email === 'ctutc.jbocales@gmail.com'",
      "$quizId": {
        // Anyone with the Quiz ID can read encrypted quiz data
        // (decryption requires the secret key)
        ".read": true,
        // Only the creator teacher or system administrator can update or delete a quiz
        ".write": "auth != null && (!data.exists() || data.child('creatorUid').val() === auth.uid || auth.token.email === 'ctutc.jbocales@gmail.com')",
        ".validate": "newData.hasChildren(['encryptedQuizData']) && newData.child('encryptedQuizData').isString() && newData.child('encryptedQuizData').val().length < 1000000"
      }
    },
    "results": {
      // Only system administrator can fetch the entire results tree
      ".read": "auth != null && auth.token.email === 'ctutc.jbocales@gmail.com'",
      "$quizId": {
        ".read": "auth != null",
        // Allow creator or admin to clear all results when deleting a quiz
        ".write": "auth != null && (!data.exists() || root.child('quizzes').child($quizId).child('creatorUid').val() === auth.uid || auth.token.email === 'ctutc.jbocales@gmail.com')",
        "$studentId": {
          // Allow student to check their own prior submission status, or teacher management
          ".read": true,
          // Allow student submission (initial or retake with penalty reason), or teacher management/reset
          ".write": true,
          ".validate": "newData.isString() && newData.val().length < 200000"
        }
      }
    },
    "teachers": {
      "$uid": {
        // Teachers can read/write their own index; admin can manage/clean up on quiz deletion
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'ctutc.jbocales@gmail.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'ctutc.jbocales@gmail.com')"
      }
    },
    "admin": {
      // Admin metadata is restricted to system administrator
      ".read": "auth != null && auth.token.email === 'ctutc.jbocales@gmail.com'",
      "quizzes": {
        "$quizId": {
          ".read": "auth != null && auth.token.email === 'ctutc.jbocales@gmail.com'",
          ".write": "auth != null && (!data.exists() || root.child('quizzes').child($quizId).child('creatorUid').val() === auth.uid || auth.token.email === 'ctutc.jbocales@gmail.com')"
        }
      }
    }
  }
}
